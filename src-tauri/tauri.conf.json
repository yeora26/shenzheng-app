{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "前哨人物画像系统",
  "version": "0.1.0",
  "identifier": "com.shenzheng.app",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node build-frontend.js"
  },
  "app": {
    "windows": [
      {
        "title": "前哨人物画像系统",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
